# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local database copies (contain users' messages)
*.db
*.db-journal
*.db-wal
*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# capacitor generated web shell and native build artifacts
/capacitor/www/
/android/.gradle/
/android/local.properties
/android/build/
/android/app/build/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/res/values/facebook_app_id.xml
/ios/App/Pods/
/ios/App/DerivedData/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/App/App/capacitor.plugins.json
/ios/App/App/FacebookConfig.plist

# signing material
*.jks
*.keystore
*.p12
*.mobileprovision

